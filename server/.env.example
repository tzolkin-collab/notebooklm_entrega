# DEPRECATED — a connector key compartilhada NÃO autoriza mais o /token/upload.
# Foi substituída por tokens de onboarding POR-USUÁRIO (uso único, ligados a um
# email), emitidos por um admin em POST /api/admin/onboarding-token. Pode remover
# esta variável do ambiente; mantida só por compatibilidade.
# NOTEBOOKLM_CONNECTOR_API_KEY=

NOTEBOOKLM_PROFILE=default
HOST=0.0.0.0
PORT=80

# Chave Fernet que cifra os tokens Google no Postgres. VIVE SÓ NO SERVIDOR.
# Nunca a coloque em máquina cliente, README, commit ou chat. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NOTEBOOKLM_ENCRYPTION_KEY=gere-uma-chave-fernet-e-mantenha-so-aqui

# Postgres. Use sslmode=require sempre que o banco não estiver numa rede
# interna isolada. sslmode=disable trafega tudo sem TLS (o app emite warning).
DATABASE_URL=postgres://user:senha@host:5432/notebooklm?sslmode=require

# OAuth do conector MCP (Claude). Sem CLIENT_ID/SECRET o /mcp sobe sem autenticação.
#
# PUBLIC_URL é OBRIGATÓRIA e não tem default — o servidor não sobe sem ela.
# É a URL pública deste deploy; o redirect_uri do OAuth é montado como
# PUBLIC_URL + "/auth/callback" e precisa estar registrado, exatamente assim, em
# "URIs de redirecionamento autorizados" do cliente OAuth no Google Cloud Console.
PUBLIC_URL=https://<host-deste-servidor>
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Mesmo segredo no backend do bot. Minimo 32 caracteres aleatorios.
NOTEBOOKLM_BOT_CALLBACK_KEY=

# Bootstrap do PRIMEIRO admin sem acesso direto ao Postgres (POST
# /admin/bootstrap). Minimo 32 caracteres aleatorios. So precisa existir
# ate o primeiro uso -- remova do ambiente depois que o primeiro admin
# for criado; o endpoint recusa sozinho se ja existir um admin ativo.
NOTEBOOKLM_BOOTSTRAP_KEY=

# CIDR/IP do proxy — faz o rate-limit por IP enxergar o cliente real
# (uvicorn --proxy-headers). NÃO use "*": deixa o IP forjável via XFF.
#
# ATENÇÃO: com o valor errado, TODO o tráfego externo chega como o IP do proxy e
# passa a dividir um único balde de rate limit. Um usuário barrado barra todos.
# Verificado no deploy real: os logs mostravam 10.11.0.11 (o proxy) como cliente
# de todas as requisições, com esta variável em 127.0.0.1.
# O valor correto é o IP ou a faixa do proxy — ex.: 10.11.0.0/16.
FORWARDED_ALLOW_IPS=127.0.0.1

# Teto global de requisições por minuto, por IP, avaliado ANTES da autenticação.
# Complementa (não substitui) os limites por rota, que só valem depois do login.
# 120 é teto de abuso, não de uso: a operação normal fica bem abaixo disso.
NOTEBOOKLM_RATE_GLOBAL_POR_MIN=120

# ── Hardening opcional ───────────────────────────────────────────────────────
# Allowlist de front-door do OAuth do MCP. Vazio = sem restrição (o gate real
# continua sendo a ativação por um admin). Recomendado preencher com os domínios
# do escritório para negar contas externas antes do cadastro.
NOTEBOOKLM_ALLOWED_DOMAINS=
# Ex.: NOTEBOOKLM_ALLOWED_DOMAINS=exemplo.com,outro-dominio.com
NOTEBOOKLM_ALLOWED_EMAILS=

# LGPD: se true, uma pergunta só é respondida quando gravada no audit_log
# (fail-closed). Default false preserva a disponibilidade (audit tolerante).
NOTEBOOKLM_AUDIT_FAIL_CLOSED=false
